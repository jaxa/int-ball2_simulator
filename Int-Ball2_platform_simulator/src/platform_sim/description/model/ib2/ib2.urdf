<?xml version="1.0"?>
<robot name="ib2">

  <link name="base"/>

  <link name="body">
    <visual>
      <geometry>
        <mesh filename="model://ib2/media/meshes/int-ball2/Int-Ball2_20241105_v2.dae" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.324" />
      <inertia ixx="0.01400" ixy="0.00003978" ixz="-0.00003857" iyy="0.01434" iyz="0.00001885" izz="0.01324" />
    </inertial>
  </link>

  <joint name="joint" type="fixed">
    <parent link="base" />
    <child link="body" />
  </joint>

  <joint name="cameraF_joint" type="fixed">
    <parent link="body"/>
    <child  link="cameraF_link"/>
    <origin xyz="0.14 0.0 0.0 " rpy="0 0 0"/>
  </joint>

  <joint name="cameraL_joint" type="fixed">
    <parent link="body"/>
    <child  link="cameraL_link"/>
    <origin xyz=" 0.025 0.14 0.0 " rpy="0 0 1.570796326794897"/>
  </joint>

  <joint name="cameraR_joint" type="fixed">
    <parent link="body"/>
    <child  link="cameraR_link"/>
    <origin xyz=" -0.025 0.14 0.0 " rpy="0 0 1.570796326794897"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="body"/>
    <child  link="imu_link"/>
    <origin xyz=" 0.0 0.0 0.0 " rpy="0 0 0"/>
  </joint>

  <!-- Thruster plugin (gz-sim system plugin) -->
  <gazebo>
    <plugin filename="libthr.so" name="thr::Thr"/>
  </gazebo>

  <!-- Custom IMU sensor plugin (gz-sim system plugin) -->
  <gazebo>
    <plugin filename="libib2_imu_sensor_plugin.so" name="ib2_imu_sensor::Ib2ImuSensor"/>
  </gazebo>

  <!-- Pose publisher (publishes model pose to gz-transport for ros_gz_bridge) -->
  <!-- Note: publish_nested_model_pose=true is a workaround for gz-sim#2690
       where publish_model_pose is ignored and publish_nested_model_pose is
       checked instead. This causes the model's own world pose to be published. -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <update_frequency>50.0</update_frequency>
    </plugin>
  </gazebo>

  <!-- IMU sensor -->
  <link name="imu_link"/>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <!-- In Gazebo Harmonic, the built-in IMU sensor system is used.
           The custom ib2_imu_sensor_plugin is replaced by:
           1. gz-sim's built-in imu system plugin (added in the world SDF)
           2. ros_gz_bridge to bridge /imu topic to ROS 2

           Add to world SDF:
             <plugin filename="gz-sim-imu-system"
                     name="gz::sim::systems::Imu"/>

           Bridge config (ros_gz_bridge):
             - topic: /imu
               type: sensor_msgs/msg/Imu
               direction: GZ_TO_ROS
      -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Front camera -->
  <link name="cameraF_link"/>
  <gazebo reference="cameraF_link">
    <sensor type="camera" name="cameraF">
      <update_rate>30.0</update_rate>
      <topic>/camera_main/image_raw</topic>
      <gz_frame_id>cameraF_link</gz_frame_id>
      <camera name="camera_front">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <!--
        Gazebo Harmonic uses built-in sensor system + ros_gz_bridge.

        Add to world SDF:
          <plugin filename="gz-sim-sensors-system"
                  name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
          </plugin>

        Bridge config (ros_gz_bridge):
          - topic: /camera_main/image_raw
            type: sensor_msgs/msg/Image
            direction: GZ_TO_ROS
          - topic: /camera_main/camera_info
            type: sensor_msgs/msg/CameraInfo
            direction: GZ_TO_ROS
      -->
    </sensor>
  </gazebo>

  <!-- Left camera -->
  <link name="cameraL_link"/>
  <gazebo reference="cameraL_link">
    <sensor type="camera" name="cameraL">
      <update_rate>30.0</update_rate>
      <topic>/camera_left/image_raw</topic>
      <gz_frame_id>cameraL_link</gz_frame_id>
      <camera name="camera_left">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <!--
        Bridge config (ros_gz_bridge):
          - topic: /camera_left/image_raw
            type: sensor_msgs/msg/Image
            direction: GZ_TO_ROS
          - topic: /camera_left/camera_info
            type: sensor_msgs/msg/CameraInfo
            direction: GZ_TO_ROS
      -->
    </sensor>
  </gazebo>

  <!-- Right camera -->
  <link name="cameraR_link"/>
  <gazebo reference="cameraR_link">
    <sensor type="camera" name="cameraR">
      <update_rate>30.0</update_rate>
      <topic>/camera_right/image_raw</topic>
      <gz_frame_id>cameraR_link</gz_frame_id>
      <camera name="camera_right">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- Ground truth pose publisher (replaces libgazebo_ros_p3d.so) -->
  <!--
    In Gazebo Harmonic, use the PosePublisher system plugin in the world SDF:

    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <update_frequency>50.0</update_frequency>
    </plugin>

    Then bridge to ROS 2 via ros_gz_bridge:
      - topic: /ib2_tracker
        type: geometry_msgs/msg/PoseStamped
        direction: GZ_TO_ROS
  -->

</robot>
