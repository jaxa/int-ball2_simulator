<?xml version="1.0"?>
<robot name="custom_object_01">

  <link name="base"/>

  <link name="custom_object_01_body">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.2"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.216" />
      <inertia ixx="0.0136245" ixy="0.0000329" ixz="-0.0000655" iyy="0.0139967" iyz="0.0000002" izz="0.0130568" />
    </inertial>
  </link>

  <joint name="custom_object_01_joint" type="fixed">
    <parent link="base" />
    <child link="custom_object_01_body" />
  </joint>

  <!-- Pose publisher (publishes model pose to gz-transport for ros_gz_bridge) -->
  <!-- Note: publish_nested_model_pose=true is a workaround for gz-sim#2690 -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <update_frequency>50.0</update_frequency>
    </plugin>
  </gazebo>

</robot>
