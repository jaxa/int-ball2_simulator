<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Int-Ball2 ISS simulation world for Gazebo Harmonic (gz-sim) -->

  <world name="ib2_world">

    <!-- Zero gravity (ISS microgravity environment) -->
    <gravity>0 0 0</gravity>

    <!-- ======================================= -->
    <!-- Required gz-sim system plugins           -->
    <!-- ======================================= -->

    <!-- Physics engine -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>

    <!-- Scene broadcaster (required for visualization) -->
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- User commands (pause, step, etc.) -->
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Sensor rendering -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU sensor system -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- NOTE: PosePublisher must be added per-model (not world-level) via URDF <gazebo> tags -->

    <!-- ======================================= -->
    <!-- Custom simulation plugins                -->
    <!-- ======================================= -->

    <!-- Airflow disturbance (JEM airflow) -->
    <plugin filename="libairflow.so"
            name="airflow::Airflow"/>

    <!-- Navigation sensor simulation -->
    <plugin filename="libnav.so"
            name="nav::Nav"/>

    <!-- Hill equations orbital mechanics -->
    <plugin filename="libhill.so"
            name="hill::Hill"/>

    <!-- Docking magnetic attraction -->
    <plugin filename="libmag.so"
            name="mag::Mag"/>

    <!-- Model spawning (Int-Ball2 + custom objects) -->
    <plugin filename="libcustom_pose_spawn_plugin.so"
            name="custom_pose_spawn::CustomPoseSpawn">

      <!-- Int-Ball2 -->
      <model>
        <uri>model://ib2</uri>
        <specify>
          <key_x>/ib2/x</key_x>
          <key_y>/ib2/y</key_y>
          <key_z>/ib2/z</key_z>
          <key_roll>/ib2/roll</key_roll>
          <key_pitch>/ib2/pitch</key_pitch>
          <key_yaw>/ib2/yaw</key_yaw>
        </specify>
      </model>

      <!-- Custom object -->
      <model>
        <uri>model://custom_object_01</uri>
        <random>
          <key_min_x>/custom_object_01/min_x</key_min_x>
          <key_min_y>/custom_object_01/min_y</key_min_y>
          <key_min_z>/custom_object_01/min_z</key_min_z>
          <key_max_x>/custom_object_01/max_x</key_max_x>
          <key_max_y>/custom_object_01/max_y</key_max_y>
          <key_max_z>/custom_object_01/max_z</key_max_z>
          <key_min_roll>/custom_object_01/min_roll</key_min_roll>
          <key_min_pitch>/custom_object_01/min_pitch</key_min_pitch>
          <key_min_yaw>/custom_object_01/min_yaw</key_min_yaw>
          <key_max_roll>/custom_object_01/max_roll</key_max_roll>
          <key_max_pitch>/custom_object_01/max_pitch</key_max_pitch>
          <key_max_yaw>/custom_object_01/max_yaw</key_max_yaw>
        </random>
      </model>

    </plugin>

    <!-- Trajectory visualization markers -->
    <plugin filename="libib2_route_display_plugin.so"
            name="ib2_route_display::Ib2RouteDisplay"/>

    <!-- Camera Pose (GUI default view) -->
    <gui fullscreen="false">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>13.9358938 -2.8364698 4.8505872 0 0 -3.14159265358979</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World Control">
        <gz-gui>
          <title>World Control</title>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World Stats">
        <gz-gui>
          <title>World Stats</title>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Global light source (sun) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Point light sources in JPM -->
    <light type="point" name="jpm_light1">
      <pose>11 -3 5.5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <light type="point" name="jpm_light2">
      <pose>11 -7 5.5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <light type="point" name="jpm_light3">
      <pose>11 -10 5.5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>
